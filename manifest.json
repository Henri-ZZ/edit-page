{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "2.0.1",
  "description": "__MSG_extDescription__",
  "homepage_url": "https://editpage.henriz.dev",
  "author": "Henri Z",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "offscreen",
    "clipboardWrite",
    "downloads"
  ],
  "host_permissions": ["<all_urls>"]
}
