{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "homepage_url": "https://github.com/your-name/edit-page",
  "author": "Your Name",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background/background.js"
  },

  "permissions": ["tabs", "activeTab", "scripting", "storage"],

  "host_permissions": [
    "<all_urls>",
    "http://localhost:8080/*",
    "https://editpage.henri.ren/*",
    "https://editpage-pre.henri.ren/*"
  ]
}
